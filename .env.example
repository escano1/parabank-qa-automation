# URL base de la aplicación bajo prueba (debe terminar en "/").
# Por defecto: instancia local levantada con `docker compose up -d`.
BASE_URL=http://localhost:8080/parabank/

# Demo público (tiene rate limiting; usar sólo para un smoke puntual):
# BASE_URL=https://parabank.parasoft.com/parabank/

# Workers de Playwright. Se recomienda 1 por instancia de ParaBank (ver BUG-011).
# WORKERS=1
